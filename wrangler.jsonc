{
    // The dev configuration is the default. It is treated as unreliable and under development.
    // Personal variants can be created under dev using "wrangler deploy" with the option "--preview-alias <name>"
    "name": "mm",
    "compatibility_date": "2026-11-18",
    "build": { "command": "sh ./writeSiteConfig.sh https://backstage.matchmakeredlabs.net" },
    "assets": { "directory": "./_site" },
    "routes": [
        { "pattern": "dev.matchmakeredlabs.net", "custom_domain": true }
    ],
    "env": {
        "dev": {
            // No overrides here. Nevertheless, configured to prevent wrangler warnings.
            "name": "dev",
            "routes": [
                { "pattern": "dev.matchmakeredlabs.net", "custom_domain": true }
            ]
        },
        "preview": {
            "name": "preview",
            "routes": [
                { "pattern": "preview.matchmakeredlabs.net", "custom_domain": true }
            ]
        },
        "stage": {
            "name": "stage",
            "routes": [
                { "pattern": "stage2.matchmakeredlabs.net", "custom_domain": true }
            ]
        },
        // Eventually this will be replaced by app.matchmakeredlabs.net.
        "preprod": {
            "name": "preprod",
            "routes": [
                { "pattern": "preprod.matchmakeredlabs.net", "custom_domain": true }
            ],
            "build": { "command": "sh ./writeSiteConfig.sh https://kitchen.matchmakeredlabs.net" }
        },
        "app": {
            "name": "app",
            "routes": [
                { "pattern": "app.matchmakeredlabs.net", "custom_domain": true }
            ],
            "build": { "command": "sh ./writeSiteConfig.sh https://kitchen.matchmakeredlabs.net" }
        }
    }   
}
